# Copy to .env (gitignored) and fill in.

# Blockfrost project IDs, one per Midnight network, from https://blockfrost.io
# The dev server adds them to chain requests on the server side (vite.config.ts),
# so they never reach the browser. Fill in the networks you want to use.
BLOCKFROST_PREPROD_ID=
BLOCKFROST_PREVIEW_ID=
BLOCKFROST_MAINNET_ID=

# Where your proof server listens. `pnpm proof:up` starts one on this address.
# VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# Only for `pnpm proof:up`: the port and worker count of that proof server.
# PROOF_SERVER_PORT=6300
# PROOF_SERVER_WORKERS=4
