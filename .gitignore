# Secrets: seeds and project IDs live in .env, never in git
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/

# Filled by scripts/copy-zk.mjs from contract/managed/
public/

# Development diagnostics written by `pnpm dev`
.dev-log/

# Prover keys are large. Only the ones the UI proves with are committed;
# `pnpm compile` regenerates the rest. See scripts/copy-zk.mjs.
contract/managed/FanoutToken/keys/*.prover
!contract/managed/FanoutToken/keys/mint.prover

# Local agent settings and worktrees
.claude/


# Recipient lists made for a test run
pay-*.txt
