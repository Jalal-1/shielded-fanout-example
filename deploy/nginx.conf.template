# The hosted site: the built page, and the chain behind it.
#
# The page asks its own origin for /chain/<network>/..., and nginx passes the
# request to Blockfrost with that network's project ID added. The IDs come from
# the environment (on Fly: `fly secrets set`), are written into this file when
# the container starts, and never reach the browser.
#
# ${NAME} is filled in from the environment at start-up. $name without braces
# is an nginx variable.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# The project ID for the network named in the request's path.
map $chain_network $blockfrost_project_id {
  preprod "${BLOCKFROST_PREPROD_ID}";
  preview "${BLOCKFROST_PREVIEW_ID}";
  mainnet "${BLOCKFROST_MAINNET_ID}";
}

# One visitor may not use up everybody's Blockfrost allowance. Fly passes the
# visitor's address in the Fly-Client-IP header.
limit_req_zone  $http_fly_client_ip zone=chain_requests:10m rate=30r/s;
limit_conn_zone $http_fly_client_ip zone=chain_sockets:10m;

server {
  listen 8080;
  listen [::]:8080;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

  # Files with a hash in their name never change: let browsers keep them.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }

  # ── Blockfrost ─────────────────────────────────────────────────────────────
  # Blockfrost's address is looked up as requests come in, not once at start-up.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=60s;

  proxy_http_version    1.1;
  proxy_ssl_server_name on;
  proxy_read_timeout    1h;
  proxy_send_timeout    1h;
  proxy_buffering       off;
  client_max_body_size  4m;
  limit_conn            chain_sockets 40;
  limit_req_status      429;

  # The indexer: GraphQL over HTTP.
  location ~ ^/chain/(?<chain_network>preprod|preview|mainnet)/indexer$ {
    limit_req zone=chain_requests burst=200 nodelay;
    proxy_set_header project_id $blockfrost_project_id;
    proxy_pass https://midnight-$chain_network.blockfrost.io/api/v0;
  }

  # The indexer's subscriptions over WebSocket: this is how the wallet syncs.
  location ~ ^/chain/(?<chain_network>preprod|preview|mainnet)/indexer/ws$ {
    proxy_set_header project_id $blockfrost_project_id;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass https://midnight-$chain_network.blockfrost.io/api/v0/ws;
  }

  # The node's RPC over WebSocket: this is how transactions are submitted.
  location ~ ^/chain/(?<chain_network>preprod|preview|mainnet)/node$ {
    proxy_set_header project_id $blockfrost_project_id;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_pass https://rpc.midnight-$chain_network.blockfrost.io/;
  }
}
